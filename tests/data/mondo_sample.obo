format-version: 1.2
ontology: mondo-sample
remark: A tiny sample for the tests, NOT the ontology. The four terms, their
remark: names, exact synonyms and ids are copied from Mondo (release 2026-10-06,
remark: https://mondo.monarchinitiative.org, CC BY 4.0); their places in the
remark: hierarchy are simplified.

[Term]
id: MONDO:0000001
name: disease
synonym: "condition" EXACT []
synonym: "disorder" EXACT []

[Term]
id: MONDO:0005015
name: diabetes mellitus
synonym: "diabetes" EXACT []
synonym: "DM" EXACT []
is_a: MONDO:0000001 ! disease

[Term]
id: MONDO:0011382
name: sickle cell disease
synonym: "sickle cell anemia" EXACT []
synonym: "sickling disorder due to Hemoglobin S" EXACT []
is_a: MONDO:0000001 ! disease

[Term]
id: MONDO:0001134
name: essential hypertension
synonym: "idiopathic hypertension" EXACT []
synonym: "primary hypertension" EXACT []
is_a: MONDO:0000001 ! disease
